{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paran Recorder",
  "version": "0.5.0",
  "identifier": "com.paran.recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paran Recorder",
        "url": "https://bluwhite.github.io/paran-recorder/",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "resources": {
      "resources/": ""
    }
  }
}
