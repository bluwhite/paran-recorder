{
  "name": "paran-recorder",
  "version": "0.5.0",
  "private": true,
  "description": "Web-first lecture recorder with optional Tauri ONNX Runtime native acceleration",
  "author": "bluwhite",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "native:model": "node scripts/prepare-native-model.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run native:model && tauri dev",
    "tauri:exe": "npm run native:model && tauri build --no-bundle",
    "tauri:build": "npm run native:model && tauri build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^8.0.0"
  }
}
